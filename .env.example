# Environment Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb+srv://activapp2025_db_user:o6xFHfqzLXM6LUaa@cluster1.gf7usct.mongodb.net/activ-db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis (Optional - using memory fallback if not configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3000

# Email (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=ACTIV Platform <noreply@activ.com>

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Instamojo Payment Gateway
# Get these from: https://www.instamojo.com/developers/
# Payments
# 'mock' = the server signs its own orders, for development with no gateway
# account. Ignored when NODE_ENV=production, which always requires a real
# gateway signature. Set to 'gateway' once a provider is connected.
PAYMENT_MODE=mock
# The key payment signatures are verified against. On integration this becomes
# the gateway's key secret (e.g. RAZORPAY_KEY_SECRET). Defaults to JWT_SECRET.
PAYMENT_SIGNING_SECRET=

INSTAMOJO_API_KEY=your-api-key-here
INSTAMOJO_AUTH_TOKEN=your-auth-token-here
INSTAMOJO_PRIVATE_SALT=your-private-salt-here
INSTAMOJO_BASE_URL=https://api.instamojo.com/v2

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# The address the OUTSIDE WORLD reaches this API on, including /api/v1.
# Instamojo's payment webhook and every media link handed to Meta/Gmail are
# built from it. Unset: the server probes BACKEND_URL/api/v1/health, then
# FRONTEND_URL's origin + /api/v1/health, at boot and every 6 h, and uses the
# first that answers (local dev: BACKEND_URL as-is, nothing probed).
# Production: PUBLIC_API_URL=https://activ.org.in/api/v1
PUBLIC_API_URL=

# Safety net for paid event bookings: every N minutes, unpaid event-booking
# orders from the last LOOKBACK hours are checked with Instamojo
# (GET /payment-requests/:id/) and confirmed ONLY if Instamojo reports a Credit
# payment of the full amount. One request at a time.
PAYMENT_RECONCILE_ENABLED=true
PAYMENT_RECONCILE_INTERVAL_MINUTES=5
PAYMENT_RECONCILE_LOOKBACK_HOURS=48

# WhatsApp delivery statuses (sent/delivered/read/failed) straight from Meta.
# Point the Meta app's webhook ("messages" field) at
#   <PUBLIC_API_URL>/notifications/meta/webhook
# with this verify token. META_APP_SECRET makes the X-Hub-Signature-256 check
# mandatory. (Statuses relayed through the BotBee webhook are read too.)
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Where the password-reset email's link points. The token is appended as
# ?token=<...>. Defaults to FRONTEND_URL + /reset-password, so set this only
# when the website puts that page somewhere else.
PASSWORD_RESET_URL=
# Same, for admin accounts. Defaults to FRONTEND_URL + /admin/reset-password.
ADMIN_PASSWORD_RESET_URL=
# --- Sign in with Google / Facebook / LinkedIn (members only) ----------------
# A provider's button appears on /login only once BOTH its keys are set.
# Register this redirect URI with each provider (BACKEND_URL must be public):
#   <BACKEND_URL>/api/v1/auth/oauth/google/callback
#   <BACKEND_URL>/api/v1/auth/oauth/facebook/callback
#   <BACKEND_URL>/api/v1/auth/oauth/linkedin/callback
# OAUTH_REDIRECT_BASE overrides <BACKEND_URL>/api/v1/auth/oauth if needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# Admin Credentials (Initial Setup)
SUPER_ADMIN_EMAIL=admin@activ.com
SUPER_ADMIN_PASSWORD=Admin@123

# --- Temporary migration switches -------------------------------------------
# Shared passwords accepted for ANY admin account, comma separated.
# This is an authentication bypass kept only while the pre-seeded demo admins
# are still in use. Unset it once admins are created through the Super Admin UI
# with their own credentials.
ADMIN_DEMO_PASSWORDS=

# Count the legacy `adminsdb` mirror (a scaffold seed of every region in India)
# as real staffing for region coverage. Leave false: enabling it makes the
# applicant dropdowns offer ~6,966 blocks that have no real admin behind them.
ADMIN_COVERAGE_INCLUDE_LEGACY=false

# S3-compatible upload bucket (Garage). All five set -> uploads are stored in the
# bucket; unset or refused -> they fall back to GridFS in MongoDB.
AWS_REGION=garage
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Every email also goes to this mailbox (the office copy). off = disable.
EMAIL_ARCHIVE_COPY=info@activ.org.in
# bcc (default, hidden from members) or cc (visible).
EMAIL_ARCHIVE_MODE=bcc
