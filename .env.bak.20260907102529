BOTBEE_PHONE_NUMBER_ID=642450735629232

# The shared secret BotBee echoes back when you save the webhook URL. Set it to
# the same string in both places. Without it the handshake is REFUSED rather
# than waved through -- an open webhook is not a safe default.
# Webhook URL to register on BotBee:
#   <BACKEND_URL>/api/v1/notifications/botbee/webhook
BOTBEE_WEBHOOK_VERIFY_TOKEN=activ_secret_verify_token_2026

# --- Request shape, in case your BotBee account differs -----------------------
# The integration is written against BotBee's documented API. If a path or the
# auth style turns out to be different on your account, correct it HERE -- no
# code change. `node scripts/test-notifications.js --whatsapp` prints the exact
# URL, headers and body that will be sent.
#   BOTBEE_AUTH_STYLE: bearer | header | body | both   (both = send all three)
# Discovered against the live account. `/api/v1/whatsapp/send` is the SESSION
# text endpoint and cannot send a template; templates go to /send/template
# and are addressed by BotBee's internal row id, which the code resolves
# from the name via the list endpoint below.
BOTBEE_TEMPLATE_ENDPOINT=/api/v1/whatsapp/send/template
BOTBEE_TEMPLATE_LIST_ENDPOINT=/api/v1/whatsapp/template/list
# Leave blank until a live test shows which field substitutes the variables.
BOTBEE_TEMPLATE_PARAMS_FIELD=template_data


# --- Approved template names -------------------------------------------------
# Meta does NOT release a template name the moment you delete it, and a REJECTED
# template keeps its name while staying invisible in BotBee's list (which only
# shows Approved). So a name can be unusable with nothing on screen explaining
# why. If BotBee refuses a name, create the template under a different one and
# point the variable here at it — no code change, just a restart.
BOTBEE_TPL_WELCOME=activ_reg_welcome
BOTBEE_TPL_STATUS=activ_app_status
BOTBEE_TPL_PAYMENT=activ_fee_due
BOTBEE_TPL_EVENT=activ_notice_alert
BOTBEE_TEXT_ENDPOINT=/api/v1/whatsapp/send
BOTBEE_AUTH_STYLE=both
BOTBEE_TIMEOUT_MS=15000
BOTBEE_DEFAULT_COUNTRY_CODE=91

# WhatsApp templates to create and get approved on the BotBee dashboard.
# Names and PARAMETER ORDER must match exactly -- WhatsApp templates are
# positional, so a template registered with its variables in a different order
# sends a correct-looking sentence with the wrong facts in it and reports no
# error. `node scripts/test-notifications.js --templates` prints the full list.
#   activ_registration_welcome  {{1}} first name
#   activ_status_update         {{1}} first name  {{2}} status  {{3}} next step
#   activ_payment_request       {{1}} first name  {{2}} amount
#   activ_event_reminder        {{1}} first name  {{2}} event   {{3}} date

