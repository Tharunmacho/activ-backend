# --- Regional Reply-To routing -----------------------------------------------
# Every application email is addressed FROM the verified account above, with the
# region in the display name, and REPLY-TO set to the applicant's own Block /
# District / State admin -- their real registered address, read from adminsdb.
# The applicant hits Reply and reaches the office holding their file.
#
# A region with no staffed admin falls back to block.<name>@EMAIL_REGION_DOMAIN,
# then to EMAIL_SUPPORT_ADDRESS.
EMAIL_REGION_DOMAIN=activ.org.in
EMAIL_SUPPORT_ADDRESS=support@activ.org.in

# Put the region in the FROM ADDRESS as well, not only the display name.
# LEAVE THIS false until every district.*/block.*@activ.org.in alias has been
# created AND verified as a send-as identity on the account above. Without that
# verification Gmail refuses with 553 and other hosts land the mail in spam,
# because the From domain no longer aligns with SPF/DMARC.
EMAIL_USE_REGIONAL_FROM=false

