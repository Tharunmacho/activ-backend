{
    "name": "activ-backend",
    "version": "1.0.0",
    "description": "ACTIV Platform Backend API",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "test:workflow": "node tests/approval-workflow.test.js",
        "test:regions": "node tests/region-architecture.test.js",
        "test:dashboard": "node tests/member-dashboard.test.js",
        "test:e2e": "node tests/e2e-approval-flow.test.js",
        "test:cms": "node tests/cms-content.test.js",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "pm2:start": "pm2 start pm2.config.js",
        "pm2:stop": "pm2 stop activ-backend",
        "pm2:restart": "pm2 restart activ-backend",
        "pm2:logs": "pm2 logs activ-backend",
        "test:forms": "node tests/registration-forms.test.js"
    },
    "keywords": [
        "activ",
        "membership",
        "api"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
