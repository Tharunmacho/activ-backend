        "redis": "^4.6.10",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "pm2": "^5.3.0",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
