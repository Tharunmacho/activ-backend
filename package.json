{
  "name": "activ-backend",
  "version": "1.0.0",
  "description": "ACTIV Platform Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:local": "node scripts/local-api.js",
    "test:oauth-login": "node tests/oauth-login.test.js && node tests/oauth-app-client.test.js && node tests/oauth-providers.test.js && node tests/oauth-one-time.test.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:workflow": "node tests/approval-workflow.test.js",
    "test:regions": "node tests/region-architecture.test.js && node tests/india-regions.test.js",
    "test:dashboard": "node tests/member-dashboard.test.js",
    "test:e2e": "node tests/e2e-approval-flow.test.js",
    "test:messaging": "node tests/messaging.test.js",
    "test:cms": "node tests/cms-content.test.js && node tests/cms-field-survival.test.js",
    "test:share-previews": "node tests/share-previews.test.js",
    "test:contact": "node tests/contact-offices.test.js && node tests/social-links.test.js && node tests/social-editor-sync.test.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "pm2:start": "pm2 start pm2.config.js",
    "pm2:stop": "pm2 stop activ-backend",
    "pm2:restart": "pm2 restart activ-backend",
    "pm2:logs": "pm2 logs activ-backend",
    "test:forms": "node tests/registration-forms.test.js",
    "test:whatsapp": "node tests/whatsapp-templates.test.js",
    "test:instamojo": "node tests/instamojo-membership.test.js",
    "test:membership-upgrade": "node tests/membership-upgrade.test.js",
    "test:membership-registrations": "node tests/membership-registrations.test.js",
    "test:platinum-office": "node tests/platinum-office.test.js",
    "test:membership-messages": "node tests/membership-messages.test.js",
    "test:plans": "node tests/membership-plans.test.js",
    "test:members": "node tests/members-state.test.js",
    "test:donations": "node tests/donations.test.js",
    "test:my-events": "node tests/my-event-registrations.test.js",
    "test:delivery": "node tests/booking-delivery.test.js",
    "test:flex": "node tests/whatsapp-flex.test.js",
    "test:checkin": "node tests/event-checkin.test.js",
    "test:email": "node tests/email-archive.test.js",
    "test:staff": "node tests/staff-accounts.test.js",
    "test:admin-management": "node tests/national-admin-plan.test.js && node tests/admin-id-allocation.test.js && node tests/admin-removals.test.js && node tests/membership-contact.test.js && node tests/regional-reset-routing.test.js",
    "admins:provision": "node scripts/provision-national-admins.js"
  },
  "keywords": [
    "activ",
    "membership",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.4",
    "redis": "^4.6.10",
    "sharp": "^0.33.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
