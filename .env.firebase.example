# Merge into the backend host's PRIVATE environment; do not replace other settings.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Choose ONE credential method. Never put a private key in the mobile app or website.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/activ-firebase-service-account.json
NOTIFICATION_WORKER_ENABLED=true

# Existing direct social sign-in. Keep the configured production values.
