# Production (the same callbacks are used for web and app login):
FRONTEND_URL=https://activ.org.in
BACKEND_URL=https://api.activ.org.in
OAUTH_REDIRECT_BASE=https://api.activ.org.in/api/v1/auth/oauth
OAUTH_APP_REDIRECT=activ://auth/social

# Register these EXACT URLs in their respective provider dashboards:
# Google:   https://api.activ.org.in/api/v1/auth/oauth/google/callback
# Facebook: https://api.activ.org.in/api/v1/auth/oauth/facebook/callback
# LinkedIn: https://api.activ.org.in/api/v1/auth/oauth/linkedin/callback
# LinkedIn also requires the "Sign In with LinkedIn using OpenID Connect" product.
# Public Facebook users require Live mode and the applicable email permissions.
# For local web testing, use FRONTEND_URL=http://localhost:8080 and
# OAUTH_REDIRECT_BASE=http://localhost:5057/api/v1/auth/oauth (5000 for npm run dev).
# Add each /{provider}/callback URL for that local port in the provider console
# wherever that provider permits localhost. A production callback cannot be
# used to finish a local backend session. Restart the backend after env changes.
